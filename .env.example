APP_NAME=CryptoPOS
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

SECRET_KEY=change-me-to-a-long-random-secret-key-64chars-minimum-please
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

DATABASE_URL=postgresql+asyncpg://cryptopos:cryptopos@localhost:5432/cryptopos
DATABASE_URL_SYNC=postgresql+psycopg://cryptopos:cryptopos@localhost:5432/cryptopos

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.bacgroupsa.com,https://bacgroupsa.com

RATE_LIMIT_PER_MINUTE=120

DEFAULT_PAYMENT_GATEWAY=sandbox
DEFAULT_EXCHANGE_PROVIDER=sandbox
DEFAULT_WALLET_NETWORK=trc20
ALLOWED_CURRENCIES=SAR,USD,EUR

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_TIMEOUT_SECONDS=30
NOWPAYMENTS_POS_VERIFIED=false

MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_TIMEOUT_SECONDS=30

PLATFORM_FEE_PERCENT=1.5
SETTLEMENT_CURRENCY=USDT

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=info@bacgroupsa.com
